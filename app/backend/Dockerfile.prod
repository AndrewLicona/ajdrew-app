FROM node:20-alpine AS builder
WORKDIR /app

RUN apk add --no-cache python3 make g++ && \
    npm install -g pnpm@10.18.0

COPY pnpm-lock.yaml pnpm-workspace.yaml ./
COPY package.json ./
COPY app/backend/package.json ./app/backend/
COPY packages/shared/package.json ./packages/shared/
COPY app/backend/prisma ./app/backend/prisma

RUN pnpm install

COPY . .

ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN pnpm --filter backend prisma:generate
RUN pnpm --filter backend build
RUN pnpm --filter backend deploy --prod --legacy /app/out
RUN cp app/backend/create-admin.js /app/out/create-admin.js || true
RUN cp -r app/backend/prisma /app/out/prisma || true

FROM node:20-alpine AS runner
WORKDIR /app

RUN apk add --no-cache openssl libc6-compat wget

ENV NODE_ENV=production
ENV PORT=3000

COPY --from=builder /app/out ./

EXPOSE 3000
CMD ["sh", "-c", "npx prisma db push --accept-data-loss && node dist/main.js"]


