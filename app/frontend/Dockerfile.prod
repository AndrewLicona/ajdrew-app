# Etapa de construcción
FROM node:20-slim AS builder
WORKDIR /app

# Instalar pnpm mediante binario standalone
RUN apt-get update && apt-get install -y wget && \
    wget -qO /usr/local/bin/pnpm https://github.com/pnpm/pnpm/releases/download/v10.18.0/pnpm-linux-x64 && \
    chmod +x /usr/local/bin/pnpm

# Copiar archivos necesarios
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
COPY package.json ./
COPY app/frontend/package.json ./app/frontend/
COPY packages/shared/package.json ./packages/shared/

# Instalar dependencias
RUN pnpm install

# Copiar el resto del código
COPY . .

# Variables de entorno de build time (necesarias para Next.js)
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

ARG NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME
ENV NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=$NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME

ARG NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET
ENV NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=$NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET

ARG NEXT_PUBLIC_ENABLE_ADS=false
ENV NEXT_PUBLIC_ENABLE_ADS=$NEXT_PUBLIC_ENABLE_ADS

ARG NEXT_PUBLIC_ADSENSE_PUB_ID
ENV NEXT_PUBLIC_ADSENSE_PUB_ID=$NEXT_PUBLIC_ADSENSE_PUB_ID

# Construir la aplicación
RUN pnpm --filter frontend build

# Etapa de producción
FROM node:20-slim
WORKDIR /app

# Variables de entorno
ENV NODE_ENV=production
ENV PORT=80

# Copiar solo lo necesario
COPY --from=builder /app/app/frontend/.next/standalone ./
COPY --from=builder /app/app/frontend/.next/static ./app/frontend/.next/static
COPY --from=builder /app/app/frontend/.next/static ./.next/static
COPY --from=builder /app/app/frontend/public ./app/frontend/public

# Puerto expuesto
EXPOSE 80

# Comando para iniciar
CMD ["node", "server.js"]
