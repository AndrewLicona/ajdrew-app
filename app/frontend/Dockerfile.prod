FROM node:20-alpine AS builder
WORKDIR /app

RUN npm install -g pnpm@10.18.0

COPY pnpm-lock.yaml pnpm-workspace.yaml ./
COPY package.json ./
COPY app/frontend/package.json ./app/frontend/
COPY packages/shared/package.json ./packages/shared/

RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install

COPY app/frontend ./app/frontend
COPY packages/shared ./packages/shared

ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

ARG NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME
ENV NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=$NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME

ARG NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET
ENV NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=$NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET

ARG NEXT_PUBLIC_ENABLE_ADS=false
ENV NEXT_PUBLIC_ENABLE_ADS=$NEXT_PUBLIC_ENABLE_ADS

ARG NEXT_PUBLIC_ADSENSE_PUB_ID
ENV NEXT_PUBLIC_ADSENSE_PUB_ID=$NEXT_PUBLIC_ADSENSE_PUB_ID

RUN --mount=type=cache,target=/app/app/frontend/.next/cache \
    pnpm --filter frontend build

FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=80
ENV HOSTNAME=0.0.0.0

COPY --from=builder /app/app/frontend/.next/standalone ./
COPY --from=builder /app/app/frontend/.next/static ./app/frontend/.next/static
COPY --from=builder /app/app/frontend/.next/static ./.next/static
COPY --from=builder /app/app/frontend/public ./app/frontend/public

EXPOSE 80

WORKDIR /app/app/frontend
CMD ["node", "server.js"]


