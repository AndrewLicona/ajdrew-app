generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  nombre              String
  rol                 Rol                  @default(EDITOR)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sorteosParticipados SorteoParticipante[]
  sorteosGanados      SorteoWinner[]
}

model Juego {
  id          String            @id @default(cuid())
  nombre      String
  slug        String            @unique
  descripcion String?
  image       String?
  activo      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  categorias  Categoria[]
  sorteos     Sorteo[]
  tutoriales  Tutorial[]
  votaciones  VotacionBracket[]
}

model Tutorial {
  id          String         @id @default(cuid())
  titulo      String
  slug        String         @unique
  videoUrl    String
  descripcion String?
  dificultad  String         @default("MEDIO")
  destacado   Boolean        @default(false)
  activo      Boolean        @default(true)
  juegoId     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  image       String?
  categoriaId String?
  categoria   Categoria?     @relation(fields: [categoriaId], references: [id])
  juego       Juego?         @relation(fields: [juegoId], references: [id])
  pasos       TutorialStep[]
}

model TutorialStep {
  id          String   @id @default(cuid())
  orden       Int
  titulo      String
  descripcion String?
  image       String?
  tutorialId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tutorial    Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)
}

model Categoria {
  id         String            @id @default(cuid())
  nombre     String
  activa     Boolean           @default(true)
  tipo       String
  juegoId    String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  juego      Juego?            @relation(fields: [juegoId], references: [id])
  items      ItemCalificable[]
  tutoriales Tutorial[]
  votaciones VotacionBracket[]
}

model ItemCalificable {
  id             String         @id @default(cuid())
  nombre         String
  categoriaId    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  image          String?
  matchesWon     BracketMatch[] @relation("MatchWinner")
  matchesSideA   BracketMatch[] @relation("MatchSideA")
  matchesSideB   BracketMatch[] @relation("MatchSideB")
  calificaciones Calificacion[]
  categoria      Categoria      @relation(fields: [categoriaId], references: [id])
}

model Calificacion {
  id         String          @id @default(cuid())
  puntuacion Int
  ip         String?
  itemId     String
  createdAt  DateTime        @default(now())
  deviceId   String?
  item       ItemCalificable @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model VotacionBracket {
  id                  String               @id @default(cuid())
  tematica            String
  slug                String               @unique
  estado              String               @default("BORRADOR")
  rondaActual         Int                  @default(1)
  rondaDuracion       Int                  @default(0) // En horas, 0 significa manual
  proximoCierreAt     DateTime?
  juegoId             String
  categoriaId         String?
  activa              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  matches             BracketMatch[]
  categoria           Categoria?           @relation(fields: [categoriaId], references: [id])
  juego               Juego                @relation(fields: [juegoId], references: [id])
  discordPublications DiscordPublication[]
}

model Publicacion {
  id        String   @id @default(cuid())
  titulo    String
  contenido String
  enlace    String?
  tipo      String   @default("NORMAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BracketMatch {
  id        String           @id @default(cuid())
  bracketId String
  ronda     Int
  itemAId   String?
  itemBId   String?
  votosA    Int              @default(0)
  votosB    Int              @default(0)
  ganadorId String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  bracket   VotacionBracket  @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  ganador   ItemCalificable? @relation("MatchWinner", fields: [ganadorId], references: [id])
  itemA     ItemCalificable? @relation("MatchSideA", fields: [itemAId], references: [id])
  itemB     ItemCalificable? @relation("MatchSideB", fields: [itemBId], references: [id])
  votos     BracketVote[]
}

model BracketVote {
  id           String       @id @default(cuid())
  matchId      String
  deviceId     String
  chosenItemId String
  createdAt    DateTime     @default(now())
  match        BracketMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, deviceId])
}

model Sorteo {
  id            String               @id @default(cuid())
  titulo        String
  descripcion   String?
  premio        String
  fechaFin      DateTime
  estado        String               @default("ACTIVO")
  juegoId       String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  numGanadores  Int                  @default(1)
  image         String?
  externalUrl   String?
  juego         Juego?               @relation(fields: [juegoId], references: [id])
  participantes SorteoParticipante[]
  tareas        SorteoTask[]
  ganadores     SorteoWinner[]
}

model SorteoParticipante {
  id            String             @id @default(uuid())
  sorteoId      String
  usuarioId     String?
  createdAt     DateTime           @default(now())
  email         String?
  nombre        String?
  deviceId      String?
  trafficSource String?
  tareas        ParticipanteTask[]
  entries       SorteoEntry[]
  sorteo        Sorteo             @relation(fields: [sorteoId], references: [id], onDelete: Cascade)
  usuario       Usuario?           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([sorteoId, usuarioId])
  @@unique([sorteoId, email])
  @@unique([sorteoId, deviceId])
}

model SorteoEntry {
  id             String             @id @default(uuid())
  participanteId String
  accion         String
  origen         String?
  createdAt      DateTime           @default(now())
  participante   SorteoParticipante @relation(fields: [participanteId], references: [id], onDelete: Cascade)

  @@index([participanteId])
}

model SorteoTask {
  id              String             @id @default(uuid())
  sorteoId        String
  tipo            String
  plataforma      String
  obligatorio     Boolean            @default(false)
  url             String?
  descripcion     String?
  createdAt       DateTime           @default(now())
  participaciones ParticipanteTask[]
  sorteo          Sorteo             @relation(fields: [sorteoId], references: [id], onDelete: Cascade)
}

model ParticipanteTask {
  id             String             @id @default(uuid())
  participanteId String
  taskId         String
  completada     Boolean            @default(false)
  verificada     Boolean            @default(false)
  evidenciaUrl   String?
  evidenciaTexto String?
  completadaAt   DateTime           @default(now())
  participante   SorteoParticipante @relation(fields: [participanteId], references: [id], onDelete: Cascade)
  task           SorteoTask         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([participanteId, taskId])
}

model SorteoWinner {
  id           String   @id @default(cuid())
  sorteoId     String
  usuarioId    String?
  createdAt    DateTime @default(now())
  emailManual  String?
  nombreManual String?
  sorteo       Sorteo   @relation(fields: [sorteoId], references: [id], onDelete: Cascade)
  usuario      Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

enum Rol {
  ADMIN
  EDITOR
}

model DiscordWebhook {
  id         String   @id @default(uuid())
  name       String
  webhookUrl String   @db.Text
  channelId  String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  publications DiscordPublication[]
}

model DiscordPublication {
  id          String    @id @default(uuid())
  webhookId   String
  bracketId   String
  round       Int
  messageId   String?
  imageUrl    String?
  status      String    @default("pending")
  error       String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  webhook DiscordWebhook  @relation(fields: [webhookId], references: [id])
  bracket VotacionBracket @relation(fields: [bracketId], references: [id])

  @@index([bracketId, round])
  @@index([webhookId])
}
