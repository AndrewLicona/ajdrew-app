# Etapa de construcción
FROM node:20-alpine AS builder
WORKDIR /app

# Instalar pnpm y herramientas de construcción para bcrypt (módulos nativos)
RUN apk add --no-cache python3 make g++ && \
    npm install -g pnpm@10.18.0

# Copiar archivos necesarios
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
COPY package.json ./
COPY app/backend/package.json ./app/backend/
COPY packages/shared/package.json ./packages/shared/

# IMPORTANTE: Copiar schema de Prisma ANTES del install
COPY app/backend/prisma ./app/backend/prisma

# Instalar dependencias
RUN pnpm install

# Copiar el resto del código
COPY . .

# Construir la aplicación
ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN pnpm --filter backend build

# Etapa de producción
FROM node:20-alpine
RUN apk add --no-cache wget libc6-compat
WORKDIR /app/app/backend

# Variables de entorno
ENV NODE_ENV=production
ENV PORT=3000

# Copiar artefactos construidos y package.json
COPY --from=builder /app/app/backend/package.json ./
COPY --from=builder /app/app/backend/tsconfig.json ./
COPY --from=builder /app/app/backend/create-admin.ts /app/app/backend/create-admin.js ./
COPY --from=builder /app/app/backend/dist ./dist
COPY --from=builder /app/app/backend/prisma ./prisma

# Instalar dependencias de producción limpias
RUN npm install -g pnpm@10.18.0 && pnpm install --prod --ignore-workspace

# Puerto expuesto
EXPOSE 3000

# Comando para iniciar
CMD ["node", "dist/main.js"]
