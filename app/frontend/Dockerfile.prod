FROM node:20-alpine
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=80

# Copiar el build standalone ya compilado en el host
COPY app/frontend/.next/standalone/ ./
COPY app/frontend/.next/static/ ./app/frontend/.next/static/
COPY app/frontend/public/ ./app/frontend/public/

EXPOSE 80
CMD ["node", "server.js"]
