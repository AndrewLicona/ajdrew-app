FROM node:20-alpine AS builder
WORKDIR /app

RUN apk add --no-cache libc6-compat openssl && \
    npm install -g pnpm@10.18.0

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc* ./
COPY app/backend/package.json ./app/backend/
COPY packages/shared/package.json ./packages/shared/
COPY app/backend/prisma ./app/backend/prisma

RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install

COPY app/backend ./app/backend
COPY packages/shared ./packages/shared

ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN pnpm --filter backend prisma:generate
RUN pnpm --filter backend build

FROM node:20-alpine AS runner
WORKDIR /app

RUN apk add --no-cache openssl libc6-compat wget

ENV NODE_ENV=production
ENV PORT=3000
ENV NODE_PATH=/app/app/backend/node_modules:/app/node_modules

# Copiar dependencias y artefactos compilados del monorepo
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/app/backend/node_modules ./app/backend/node_modules
COPY --from=builder /app/app/backend/dist ./app/backend/dist
COPY --from=builder /app/app/backend/prisma ./app/backend/prisma
COPY --from=builder /app/app/backend/package.json ./app/backend/package.json
COPY --from=builder /app/app/backend/create-admin.js ./app/backend/create-admin.js
COPY --from=builder /app/app/backend/create-admin.ts ./app/backend/create-admin.ts
COPY --from=builder /app/packages/shared ./packages/shared

# Crear carpeta public y enlaces en la raíz /app para compatibilidad
RUN mkdir -p /app/app/backend/public && \
    ln -s /app/app/backend/dist /app/dist && \
    ln -s /app/app/backend/prisma /app/prisma && \
    ln -s /app/app/backend/public /app/public && \
    ln -s /app/app/backend/create-admin.js /app/create-admin.js && \
    ln -s /app/app/backend/create-admin.ts /app/create-admin.ts

WORKDIR /app/app/backend

EXPOSE 3000
CMD ["sh", "-c", "npx prisma db push --accept-data-loss && node dist/main.js"]


